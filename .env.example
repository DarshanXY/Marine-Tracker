# ═══════════════════════════════════════════════════════
# Marine Plastic Tracker  |  Environment Template
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ═══════════════════════════════════════════════════════

# ─── Database (PostgreSQL + PostGIS) ─────────────────
POSTGRES_USER=mpt_user
POSTGRES_PASSWORD=change_me_strong_password
POSTGRES_DB=marine_plastic
DATABASE_URL=postgresql://mpt_user:change_me_strong_password@localhost:5432/marine_plastic

# Connection pool — appended to DATABASE_URL by the backend as connection_limit /
# pool_timeout / connect_timeout / application_name. Anything already present in
# the URL wins. Size the pool per API instance so that
#   instances * DB_POOL_SIZE  <  postgres max_connections (default 100).
DB_POOL_SIZE=10
DB_POOL_TIMEOUT=15
DB_CONNECT_TIMEOUT=10
DB_APP_NAME=marine-plastic-tracker-api

# Boot-time connect retry (exponential backoff, capped) + self-heal poll.
DB_CONNECT_ATTEMPTS=5
DB_RETRY_BASE_MS=400
DB_RETRY_MAX_MS=5000
# Hard ceiling on the whole retry loop — this is what bounds worst-case boot time
# when the database is down (a refused connect costs Prisma ~4s to report).
DB_CONNECT_DEADLINE_MS=12000
DB_HEALTH_INTERVAL_MS=30000

# Connection log destination. Default: infra/logs/db-connection.log ("-" = off).
# DB_LOG_FILE=

# ─── Redis (BullMQ queue) ────────────────────────────
REDIS_PASSWORD=change_me_redis_password
REDIS_URL=redis://:change_me_redis_password@localhost:6379

# ─── Backend (Node.js / Express) ─────────────────────
NODE_ENV=development
PORT=3001

# JWT — generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=generate_me_64_char_random_hex_string_here_000000000000000000000000000000000
JWT_REFRESH_SECRET=generate_me_different_64_char_random_hex_string_000000000000000000000

JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d
BCRYPT_ROUNDS=12
TOTP_ISSUER=MarinePlasticTracker

# ─── Python Engine (FastAPI) ─────────────────────────
PYTHON_ENGINE_PORT=8000
# DEMO_MODE=true means the full pipeline runs on seeded/simulated data
# without real Copernicus/CMEMS/ERA5 credentials.
DEMO_MODE=true
# TEMPORARY: inject a labelled synthetic plastic cluster into areas saved from
# Map Explorer when the scan found none, so the Areas drift forecast can run.
DEMO_PLASTIC=true

# ─── Satellite Data — Sentinel-2 (optional; demo mode uses seeded imagery) ──
# The old "Copernicus Open Access Hub / SciHub" was RETIRED in 2023. The current
# free source is the Copernicus Data Space Ecosystem (CDSE). Register FREE (no
# credit card): https://dataspace.copernicus.eu  →  after login open the
# Sentinel Hub dashboard  →  User settings  →  OAuth clients  →  "Create new".
# That gives you a client id (a UUID) and a client secret (the "API key" pair).
#
# provider: cdse | sentinelhub | aws-stac | demo
SATELLITE_PROVIDER=demo

# Sentinel Hub OAuth2 client credentials (from the CDSE dashboard).
# Example FORMAT only — replace with your own real values:
#   SENTINEL_HUB_CLIENT_ID=8b1c9e42-3f7a-4d21-9c6e-0a2f5b7d1e34
#   SENTINEL_HUB_CLIENT_SECRET=Xy9Qv2Lm7Rt4Kd0Pb6Wn8Zs1Hc3Ug5Ea
SENTINEL_HUB_CLIENT_ID=
SENTINEL_HUB_CLIENT_SECRET=
SENTINEL_HUB_BASE_URL=https://sh.dataspace.copernicus.eu
SENTINEL_HUB_TOKEN_URL=https://identity.dataspace.copernicus.eu/auth/realms/CDSE/protocol/openid-connect/token

# Zero-credential fallback: Element84 Earth Search (AWS Open Data, no key needed)
AWS_STAC_URL=https://earth-search.aws.element84.com/v1

# Legacy CDSE OData download (your dataspace.copernicus.eu account login)
CDSE_USERNAME=
CDSE_PASSWORD=
CDSE_ODATA_URL=https://catalogue.dataspace.copernicus.eu/odata/v1

# CMEMS (ocean currents for drift model)
CMEMS_USERNAME=
CMEMS_PASSWORD=

# ERA5 (wind data for drift model) — via CDS API
ERA5_API_KEY=
ERA5_API_URL=https://cds.climate.copernicus.eu/api/v2

# ─── Alerts (optional — demo mode logs but does not send) ──
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
TWILIO_SMS_FROM=

ALERT_EMAIL_FROM=alerts@marine-plastic-tracker.example
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# ─── Frontend (Vite — prefix VITE_ to expose to browser) ──
VITE_API_URL=http://localhost:3001
VITE_PYTHON_ENGINE_URL=http://localhost:8000
VITE_DEMO_MODE=true
# Optional tile layer token (app works with free OSM tiles without this)
VITE_MAPBOX_TOKEN=

# ─── Object Storage ──────────────────────────────────
# STORAGE_DRIVER=local  →  files go to STORAGE_LOCAL_PATH (no extra config needed)
# STORAGE_DRIVER=s3     →  set S3_* vars below (swap any S3-compatible provider)
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=./data/imagery

# S3-compatible (Cloudflare R2 / MinIO / AWS S3 — swap freely)
# S3_ENDPOINT=https://your-account.r2.cloudflarestorage.com
# S3_BUCKET=marine-plastic-tracker
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_REGION=ap-south-1
# S3_FORCE_PATH_STYLE=false

# ─── Observability (optional) ────────────────────────
LOG_LEVEL=info
# SENTRY_DSN=

# --- MySQL dataset browser (database/mysql/README.md) ---
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_LOADER_USER=mpt_loader
MYSQL_LOADER_PASSWORD=change_me
MYSQL_DATASETS_DB=mpt_datasets
MYSQL_APP_DB=mpt_app
